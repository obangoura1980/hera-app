{
  "expo": {
    "name": "Hera",
    "slug": "frontend",
    "version": "6.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hera.herapp",
      "buildNumber": "603",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose photos for your profile and vision board",
        "NSUserTrackingUsageDescription": "Helps us understand how you discovered Hera"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1E0A3C"
      },
      "package": "com.hera.herapp",
      "versionCode": 10
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#080A18"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/feather",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos for your profile and vision board",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#A855F7"
        }
      ],
      "@react-native-vector-icons/ionicons",
      "@react-native-vector-icons/material-icons",
      [
        "react-native-appsflyer",
        {
          "shouldUseStrictMode": false,
          "shouldUsePurchaseConnector": false,
          "preferAppsFlyerBackupRules": false
        }
      ],
      "./plugins/withAndroidBackupRulesFix"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
